# ---------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Build and distribution
.python-version.local
pip-wheel-metadata/
wheels/
share/python-wheels/

# Python packaging
*.egg
*.egg-info/
.eggs/
dist/
build/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking and linting
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Local Python environment files
.python_history


# ---------------------------------------------------------
# POSTGRESQL / DATABASE FILES
# ---------------------------------------------------------

# PostgreSQL data directories and local database files
postgres/data/
postgres/pgdata/
postgres/pgdata-*/
postgres/data-*/

# PostgreSQL binary/data files
*.dump
*.backup
*.bak
*.sql.gz

# Temporary database exports
*.sql.tmp

# SQLite files
*.sqlite
*.sqlite3
*.sqlite-journal


# ---------------------------------------------------------
