# ---------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.env
*.env.local
*.env.development
*.env.production

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Cloud and service credentials
credentials.json
service-account*.json
secrets/
.secrets/


# ---------------------------------------------------------
