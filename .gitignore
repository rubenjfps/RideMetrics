# ---------------------------------------------------------

node_modules/
.next/
out/
build/
dist/
coverage/

# Next.js generated files
next-env.d.ts

# TypeScript cache
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment files
.vercel/
.turbo/


# ---------------------------------------------------------
# PRISMA
# ---------------------------------------------------------

# Prisma local databases
*.db
*.db-journal

# Prisma debug logs
prisma-debug.log*


